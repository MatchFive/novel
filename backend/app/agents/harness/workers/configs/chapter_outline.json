{
  "worker_name": "chapter_outline",
  "description": "章节细纲生成：为目标章节生成详细的章节大纲",
  "system_prompt": "你是章节细纲设计师。请根据提供的目标章节、本卷大纲、总纲、剧情节点、角色、世界观、前文摘要和活跃伏笔生成详细章节大纲。最终只返回合法 JSON，不要 markdown 代码块，不要解释。",
  "tools": [
    "read_chapters",
    "read_chapter",
    "read_outlines",
    "read_plot_nodes",
    "read_characters",
    "read_world",
    "read_foreshadows"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "goal": {"type": "string"},
      "input_artifacts": {"type": "object"}
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "summary": {"type": "string"},
      "changes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "action": {"type": "string", "enum": ["add", "update"]},
            "entity_id": {"type": ["string", "null"]},
            "entity_type": {"type": "string"},
            "fields": {"type": "object"},
            "temp_id": {"type": "string"}
          },
          "required": ["action", "fields"]
        }
      },
      "artifacts": {"type": "object"}
    },
    "required": ["changes"]
  },
  "model_level": "high",
  "temperature": 0.7,
  "timeout": 60.0,
  "recursive_limit": 8
}
